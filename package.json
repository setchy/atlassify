{
  "name": "atlassify",
  "version": "3.17.3",
  "private": true,
  "description": "Atlassian notifications on your menu bar.",
  "main": "build/main.js",
  "scripts": {
    "clean": "rimraf build coverage dist node_modules",
    "prepare": "husky",
    "build": "vite build",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm codegen --watch",
    "dev": "concurrently --names \"vite,codegen\" --prefix-colors \"blue,magenta\" \"vite dev\" \"pnpm codegen:watch\"",
    "devtools": "concurrently --names \"dev,devtools\" --prefix-colors \"cyan,green\" \"pnpm dev\" \"react-devtools\"",
    "start": "pnpm build && pnpm dev",
    "package:linux": "electron-builder --linux",
    "package:macos": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "i18n:extract": "i18next-cli extract --sync-all",
    "i18n:check": "concurrently --kill-others-on-fail --names \"sync,values,defaults\" --prefix-colors \"yellow,green,cyan\" \"pnpm i18n:check:sync\" \"pnpm i18n:check:values\" \"pnpm i18n:check:defaults\"",
    "i18n:check:sync": "i18next-cli extract --ci --quiet",
    "i18n:check:values": "node ./scripts/check-en-locales.mjs",
    "i18n:check:defaults": "node ./scripts/check-t-defaults.mts",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "lint": "biome lint --fix .",
    "lint:check": "biome lint .",
    "lint:ci": "biome ci --reporter=github",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --coverage --run",
    "test:ci": "vitest --coverage --run --reporter=default --reporter=github-actions",
    "test:watch": "vitest --watch --coverage",
    "test:ui": "vitest --ui"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/setchy/atlassify.git"
  },
  "keywords": [
    "atlassify",
    "atlassian",
    "bitbucket",
    "compass",
    "confluence",
    "jira",
    "notifications",
    "electron",
    "menubar",
    "taskbar",
    "tray"
  ],
  "author": {
    "name": "Adam Setch",
    "url": "https://github.com/setchy"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/setchy/atlassify/issues"
  },
  "homepage": "https://atlassify.io",
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-menubar": "11.1.3",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@aptabase/electron": "0.3.1",
    "@atlaskit/avatar": "30.1.0",
    "@atlaskit/avatar-group": "14.4.9",
    "@atlaskit/badge": "22.0.0",
    "@atlaskit/button": "25.7.0",
    "@atlaskit/checkbox": "19.3.1",
    "@atlaskit/css": "1.1.7",
    "@atlaskit/css-reset": "8.4.10",
    "@atlaskit/form": "18.3.1",
    "@atlaskit/heading": "8.0.0",
    "@atlaskit/icon": "38.0.2",
    "@atlaskit/icon-lab": "7.11.0",
    "@atlaskit/inline-message": "16.4.8",
    "@atlaskit/logo": "23.3.1",
    "@atlaskit/modal-dialog": "17.2.1",
    "@atlaskit/primitives": "22.6.0",
    "@atlaskit/radio": "10.2.6",
    "@atlaskit/select": "23.1.6",
    "@atlaskit/spinner": "20.4.4",
    "@atlaskit/tag": "17.1.0",
    "@atlaskit/tag-group": "13.4.2",
    "@atlaskit/textfield": "10.3.0",
    "@atlaskit/toggle": "17.3.5",
    "@atlaskit/tokens": "20.9.0",
    "@atlaskit/tooltip": "24.4.3",
    "@biomejs/biome": "2.6.6",
    "@compiled/react": "2.0.0",
    "@compiled/vite-plugin": "2.0.4",
    "@discordapp/twemoji": "16.0.1",
    "@electron/notarize": "3.1.2",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/schema-ast": "6.1.1",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@heroicons/react": "2.2.0",
    "@parcel/watcher": "2.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.106.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "axios": "1.21.0",
    "cn": "0.5.2",
    "concurrently": "10.0.6",
    "date-fns": "4.4.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "graphql": "17.1.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "i18next": "26.7.2",
    "i18next-browser-languagedetector": "8.3.0",
    "i18next-cli": "1.86.0",
    "react": "19.3.1",
    "react-devtools": "8.0.0",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-router-dom": "7.18.5",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-electron": "1.2.0",
    "vite-plus": "catalog:",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "lint-staged": {
    "*": "biome check --fix --no-errors-on-unmatched",
    "*.{js,ts,tsx}": [
      "bash -c 'tsc --noEmit'",
      "bash -c 'pnpm i18n:lint'",
      "pnpm test --changed --passWithNoTests --update=true"
    ]
  }
}
